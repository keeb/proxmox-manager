# Swamp runtime (ephemeral, regenerated by running workflows)
swamp/.swamp/data/
swamp/.swamp/outputs/
swamp/.swamp/workflow-runs/
swamp/.swamp/logs/
swamp/.swamp/files/
swamp/.swamp/telemetry/

# Swamp generated/evaluated files
swamp/.swamp/definitions-evaluated/
swamp/.swamp/workflows-evaluated/
swamp/.swamp/inputs-evaluated/

# Swamp caches & local datastore state (regenerated; pin absolute paths)
swamp/.swamp/_extension_catalog.db*
swamp/.swamp/audit/
swamp/.swamp/datastore/
swamp/.swamp/datastore-bundles/
swamp/.swamp/driver-bundles/

# Secrets and encryption (defense in depth — .key under vault too)
swamp/.swamp/secrets/
swamp/.swamp/vault/**/.key
swamp/.env

# Symlink views (regenerated by swamp repo rebuild-index)
swamp/models/
swamp/workflows/
swamp/vaults/
swamp/resources/

# Generic extensions are NOT vendored here. The @keeb/* generics load from
# local sources (~/git/swamp-extensions/*) wired in swamp/.swamp-sources.yaml;
# @john/* and the datastore come from registry pulls. Keep all of that out of
# the repo — only this project's own models are tracked (in swamp/local-models/).
swamp/extensions/
swamp/.swamp/pulled-extensions/
swamp/.swamp/bundles/

# Claude Code (local settings, skills, tool config)
.claude/

# Application secrets
bot/.env

# Node deps for swamp scripts
swamp/node_modules/

# Grafana dashboard scratch swamp repo
swamp/grafana/dashboards/.swamp/

# Stray nested swamp repo (scratch)
swamp/rebuild-index/

# Stale root-level swamp repo (repo now lives under swamp/)
/.swamp/
/.swamp.yaml
/extensions/
bot/.swamp/

# Scratchpad
dev-logs/
memory/
